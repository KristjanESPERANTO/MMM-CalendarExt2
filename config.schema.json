{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locale": { "type": "string" },
    "rotateInterval": {
      "type": "integer",
      "anyOf": [{ "const": 0 }, { "minimum": 1000 }],
      "description": "0 disables rotation; otherwise at least 1000 milliseconds"
    },
    "updateInterval": { "type": "integer", "minimum": 1000 },
    "deduplicateEventsOn": { "type": "array", "items": { "type": "string" } },
    "defaultSet": {
      "type": "object",
      "properties": {
        "calendar": {
          "type": "object",
          "properties": {
            "scanInterval": { "type": "integer", "minimum": 60000 }
          },
          "additionalProperties": true
        },
        "scene": { "type": "object", "additionalProperties": true },
        "view": { "type": "object", "additionalProperties": true }
      },
      "description": "Default options merged into calendars, scenes, and views"
    },
    "calendars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scanInterval": { "type": "integer", "minimum": 60000 }
        },
        "additionalProperties": true
      }
    },
    "scenes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "views": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "iconify": {
      "type": ["boolean", "string", "null"],
      "description": "Use the built-in Iconify script, a custom script URL, or null for the default"
    },
    "firstDrawingDelay": {
      "type": "integer",
      "minimum": 0,
      "description": "Delay before initial drawing, in milliseconds"
    }
  }
}
